#!/bin/sh
# Keeps the lab phone awake - whatever shell runs, or none.
#
# On USB a suspend cannot complete (the link cannot go idle): every attempt aborts at once, and a
# shell that suspends when idle retries every few seconds - each attempt drops the USB link, so the
# host sees the phone disconnect and reconnect without end (26 times in 5 minutes, once).
# Worse, a suspend that does complete while a USB blip has the port not 'configured' leaves the idle
# phone silent until someone presses power (3 'hangs' of 2026-11-18 were this: sxmo_autosuspend.sh ->
# rtcwake -m mem). So the kernel wake lock is held always; sxmo_autosuspend.sh blocks on it
# (it reads /sys/power/wakeup_count). Deliberate suspends (way-back.sh, lpoco-health cycles) write
# /sys/power/state themselves and are not held back. To let a phone idle-suspend on purpose
# (a battery test), create /etc/devlab-allow-autosleep: the lock is then held only while the USB port
# is configured, as before.
while :; do
	state=$(cat /sys/class/udc/*/state 2>/dev/null | head -n1)
	if [ ! -e /etc/devlab-allow-autosleep ] || [ "$state" = configured ]; then
		echo devlab-usb > /sys/power/wake_lock 2>/dev/null
	else
		echo devlab-usb > /sys/power/wake_unlock 2>/dev/null
	fi
	sleep 5
done
