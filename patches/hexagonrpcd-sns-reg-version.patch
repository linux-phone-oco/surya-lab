diff --git a/hexagonrpcd/hexagonfs_mapped.c b/hexagonrpcd/hexagonfs_mapped.c
index 400800f..290bcf5 100644
--- a/hexagonrpcd/hexagonfs_mapped.c
+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -542,3 +542,42 @@ struct hexagonfs_file_ops hexagonfs_mapped_sysfs_ops = {
 	.seek = mapped_seek,
 	.stat = mapped_sysfs_stat,
 };
+
+/*
+ * Open (and with O_CREAT create) the physical file behind a mapped entry of a
+ * virtual directory, for writing: the sensor framework writes a version
+ * marker next to the registry, outside every mapped directory.
+ */
+int hexagonfs_mapped_open_file(const char *path, int flags, struct hexagonfs_fd **out)
+{
+	struct hexagonfs_fd *fd;
+	struct mapped_ctx *ctx;
+	int ret;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	if (ctx == NULL)
+		return -ENOMEM;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL) {
+		free(ctx);
+		return -ENOMEM;
+	}
+
+	ctx->fd = open(path, O_RDWR | O_CLOEXEC | (flags & (O_CREAT | O_TRUNC | O_APPEND)), 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		free(fd);
+		free(ctx);
+		return ret;
+	}
+
+	ctx->dir = NULL;
+	fd->is_assigned = false;
+	fd->up = NULL;
+	fd->ops = &hexagonfs_mapped_ops;
+	fd->data = ctx;
+	*out = fd;
+
+	return 0;
+}
diff --git a/hexagonrpcd/hexagonfs_virt_dir.c b/hexagonrpcd/hexagonfs_virt_dir.c
index eaba520..867b21a 100644
--- a/hexagonrpcd/hexagonfs_virt_dir.c
+++ b/hexagonrpcd/hexagonfs_virt_dir.c
@@ -124,7 +124,20 @@ static int virt_dir_stat(struct hexagonfs_fd *fd, struct stat *stats)
 	return 0;
 }
 
+/* Only a mapped file entry of the directory can be written: nothing is created in a virtual directory. */
+static int virt_dir_create(struct hexagonfs_fd *dir, const char *name, int flags, struct hexagonfs_fd **out)
+{
+	const struct hexagonfs_dirent *const **dirlist = dir->data;
+	const struct hexagonfs_dirent *ent = walk_dir(*dirlist, name);
+
+	if (ent == NULL || ent->ops != &hexagonfs_mapped_ops)
+		return -EACCES;
+
+	return hexagonfs_mapped_open_file(ent->u.phys, flags, out);
+}
+
 struct hexagonfs_file_ops hexagonfs_virt_dir_ops = {
+	.create = virt_dir_create,
 	.close = virt_dir_close,
 	.from_dirent = virt_dir_from_dirent,
 	.openat = virt_dir_openat,
