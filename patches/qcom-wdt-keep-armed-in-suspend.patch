diff --git a/drivers/watchdog/qcom-wdt.c b/drivers/watchdog/qcom-wdt.c
index 49bd04841..76b890dbb 100644
--- a/drivers/watchdog/qcom-wdt.c
+++ b/drivers/watchdog/qcom-wdt.c
@@ -341,11 +341,20 @@ static int qcom_wdt_probe(struct platform_device *pdev)
 	return 0;
 }
 
+/*
+ * keep_armed_in_suspend: leave an armed watchdog running through system sleep. The stock driver stops it
+ * in the late suspend phase, so a hang inside s2idle has no way back; with this set, the bite resets the
+ * phone when nobody pets it (surya's suspend tries: a timeout longer than the sleep, set before suspend).
+ */
+static bool keep_armed_in_suspend;
+module_param(keep_armed_in_suspend, bool, 0644);
+MODULE_PARM_DESC(keep_armed_in_suspend, "Do not stop an armed watchdog in system suspend (default: stop it)");
+
 static int __maybe_unused qcom_wdt_suspend(struct device *dev)
 {
 	struct qcom_wdt *wdt = dev_get_drvdata(dev);
 
-	if (watchdog_active(&wdt->wdd))
+	if (!keep_armed_in_suspend && watchdog_active(&wdt->wdd))
 		qcom_wdt_stop(&wdt->wdd);
 
 	return 0;
